{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RetentionMessage",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "risk_reason",
    "recommended_action",
    "message_fr",
    "owner_task_required",
    "automation_allowed",
    "risk_flags"
  ],
  "properties": {
    "risk_reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "recommended_action": {
      "type": "string",
      "enum": ["send_email", "queue_whatsapp", "owner_call", "manual_review", "skip"]
    },
    "message_fr": {
      "type": "string",
      "minLength": 0,
      "maxLength": 700
    },
    "owner_task_required": {
      "type": "boolean"
    },
    "automation_allowed": {
      "type": "boolean"
    },
    "risk_flags": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["no_consent", "opted_out", "high_risk", "manual_review_needed"]
      },
      "uniqueItems": true
    }
  }
}

