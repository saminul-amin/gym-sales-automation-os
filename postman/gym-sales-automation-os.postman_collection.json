    {
      "name": "02 - Direct n8n Workflow 01 - Lead Intake",
      "description": "Use these requests when testing n8n webhooks directly. Set `n8n_webhook_prefix` to `webhook-test` while the workflow is listening for a test event.",
      "item": [
        {
          "name": "n8n 01 - Lead Intake - Happy Path",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{n8n_outbound_token}}",
                "disabled": true
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event_id\": \"postman_lead_happy_{{$timestamp}}\",\n  \"event_type\": \"lead.created\",\n  \"received_at\": \"{{request_timestamp}}\",\n  \"source\": \"website\",\n  \"lead\": {\n    \"name\": \"Claire Martin\",\n    \"email\": \"{{lead_email}}\",\n    \"phone\": \"{{lead_phone}}\",\n    \"original_message\": \"Bonjour, je voudrais faire une seance d'essai cette semaine pour perdre du poids.\",\n    \"fitness_goal\": \"weight_loss\",\n    \"interested_service\": \"personal_training\",\n    \"preferred_channel\": \"email\",\n    \"consent_status\": \"yes\",\n    \"opted_out\": false\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{n8n_base_url}}/{{n8n_webhook_prefix}}/lead-intake",
              "host": [
                "{{n8n_base_url}}"
              ],
              "path": [
                "{{n8n_webhook_prefix}}",
                "lead-intake"
              ]
            }
          },
          "event": [
