  "item": [
    {
      "name": "00 - Setup and Notes",
      "description": "Set collection/environment variables before running requests.\n\nRequired variables:\n- `worker_base_url`: Cloudflare Worker base URL, for example `https://gym-sales-automation-os-router.yourname.workers.dev`\n- `worker_secret`: same value as Cloudflare `WEBHOOK_SHARED_SECRET`\n- `n8n_base_url`: local or hosted n8n base URL, for example `http://localhost:5678`\n- `n8n_webhook_prefix`: use `webhook-test` while listening for a test event, or `webhook` after activating workflows\n- `lead_id`: must exist in the Google Sheet for booking tests\n- `member_id`: must exist in the Google Sheet for review tests",
      "item": [
        {
          "name": "Postman Echo - Variable Smoke Test",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "https://postman-echo.com/get?worker={{worker_base_url}}&n8n={{n8n_base_url}}&prefix={{n8n_webhook_prefix}}",
              "protocol": "https",
              "host": [
                "postman-echo",
                "com"
              ],
              "path": [
                "get"
              ],
              "query": [
                {
                  "key": "worker",
                  "value": "{{worker_base_url}}"
                },
                {
                  "key": "n8n",
                  "value": "{{n8n_base_url}}"
                },
                {
                  "key": "prefix",
                  "value": "{{n8n_webhook_prefix}}"
                }
              ]
            },
            "description": "Optional smoke test to confirm Postman variables are resolving."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Postman variables resolved', function () {",
                  "  pm.expect(pm.request.url.toString()).to.include('worker=');",
                  "  pm.expect(pm.request.url.toString()).to.include('n8n=');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "01 - Cloudflare Worker Router",
      "description": "These requests test the public Cloudflare Worker routes. The Worker then forwards normalized events to n8n production webhook URLs.",
      "item": [
        {
          "name": "Worker - Lead Created - Happy Path",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-PlugWheel-Secret",
                "value": "{{worker_secret}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event_type\": \"lead.created\",\n  \"source\": \"website\",\n  \"name\": \"Claire Martin\",\n  \"email\": \"{{lead_email}}\",\n  \"phone\": \"{{lead_phone}}\",\n  \"message\": \"Bonjour, je voudrais faire une seance d'essai cette semaine pour perdre du poids.\",\n  \"fitness_goal\": \"weight_loss\",\n  \"interested_service\": \"personal_training\",\n  \"preferred_channel\": \"email\",\n  \"consent_status\": \"yes\",\n  \"opted_out\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{worker_base_url}}/lead",
              "host": [
                "{{worker_base_url}}"
              ],
              "path": [
                "lead"
              ]
            },
            "description": "Sends a flat lead payload to the Cloudflare Worker. Worker normalizes it and forwards to n8n."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Worker accepted lead', function () { pm.response.to.have.status(202); });",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('last_event_id', json.event_id || '');",
                  "pm.test('Response includes event_id', function () { pm.expect(json.event_id).to.exist; });"
                ]
              }
            }
          ]
        },
