# Cloudflare Worker
WEBHOOK_SHARED_SECRET=replace-with-long-random-secret
N8N_LEAD_WEBHOOK_URL=https://your-n8n.example.com/webhook/lead-intake
N8N_RESAMANIA_WEBHOOK_URL=https://your-n8n.example.com/webhook/resamania-event
N8N_INTERACTION_WEBHOOK_URL=https://your-n8n.example.com/webhook/interaction-event
N8N_OUTBOUND_TOKEN=replace-with-n8n-header-auth-token

# Local frontend/backend app
BACKEND_PORT=4000
FRONTEND_ORIGIN=http://localhost:3000
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000
WORKER_BASE_URL=https://your-worker.example.workers.dev
WORKER_SHARED_SECRET=replace-with-worker-shared-secret

# OpenRouter, configured inside n8n
OPENROUTER_API_KEY=replace-with-openrouter-api-key
OPENROUTER_MODEL=replace-with-structured-output-capable-model
OPENROUTER_FALLBACK_MODEL=replace-with-fallback-model
APP_URL=https://example.com/gym-sales-automation-os

# App settings
GOOGLE_REVIEW_URL=https://g.page/r/replace-me/review
OWNER_EMAIL=owner@example.com
DEFAULT_ASSIGNEE=Gym Owner
